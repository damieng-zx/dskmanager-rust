.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude Code configuration
.claude/

# Debug and profiling
*.profdata
*.gcda
*.gcno

# Test coverage
tarpaulin-report.html
cobertura.xml
*.profraw
